{
  "name": "hillco2-spa",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "codegen": "openapi-typescript ./openapi.json -o ./src/api/schema.ts",
    "build": "npm run codegen && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "update-openapi": "curl -fsSL https://hillco2.ng20.org/openapi.json -o openapi.json && echo 'updated openapi.json'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.10",
    "@mui/material": "^6.1.10",
    "@mui/x-data-grid": "^7.23.2",
    "@mui/x-date-pickers": "^7.23.2",
    "@tanstack/react-query": "^5.62.7",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "dayjs": "^1.11.13",
    "openapi-fetch": "^0.13.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
